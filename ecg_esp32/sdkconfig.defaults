# Bluetooth - bật BT stack và NimBLE host
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Tắt Bluedroid để dùng NimBLE
CONFIG_BT_BLUEDROID_ENABLED=n

# NimBLE client features cần cho scan/connect
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# WiFi - bật để dùng MQTT over WiFi
CONFIG_ESP_WIFI_ENABLED=y

# Tăng stack size cho NimBLE host task
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# Partition table tùy chỉnh - app 1.5MB để chứa binary BT+WiFi+MQTT
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
